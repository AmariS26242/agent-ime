<?xml version="1.0" encoding="utf-8"?>
<!--
  Ordinary keyboard.  The toolbar keeps a fixed 50dp row so the Agent / 九键
  buttons never shift, and the bottom row leaves a visual gap above the
  navigation bar.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="6dp">
        <Button
            android:id="@+id/btnAgent"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="88dp"
            android:minHeight="0dp"
            android:paddingHorizontal="12dp"
            android:singleLine="true"
            android:background="@drawable/bg_primary_button"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:text="@string/toolbar_agent" />
        <Button
            android:id="@+id/btnNineKey"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingHorizontal="14dp"
            android:singleLine="true"
            android:background="@drawable/bg_secondary_button"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:text="@string/toolbar_nine_key" />
        <ImageView
            android:id="@+id/imeIndicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:importantForAccessibility="no" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/rowQwerty1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
    <LinearLayout
        android:id="@+id/rowQwerty2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
    <LinearLayout
        android:id="@+id/rowQwerty3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
    <LinearLayout
        android:id="@+id/rowBottom"
        android:paddingTop="2dp"
        android:paddingBottom="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal" />
</LinearLayout>
