<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bg"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="8dp">
        <Button
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_secondary_button"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:text="@string/toolbar_back_to_normal" />
        <TextView
            android:id="@+id/lblAgentState"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:gravity="end"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:text="@string/label_internal_prompt" />
        <Button
            android:id="@+id/btnSession"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/bg_secondary_button"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:text="@string/toolbar_session" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="8dp"
        android:padding="12dp"
        android:background="@drawable/bg_panel"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvContextSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="8dp"
            android:background="@drawable/bg_context_chip"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:text="@string/label_context_none" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <Button
                android:id="@+id/btnAddSelection"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:background="@drawable/bg_secondary_button"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:text="@string/btn_context_add_selection" />
            <Button
                android:id="@+id/btnAddDraft"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_secondary_button"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:text="@string/btn_context_add_draft" />
            <Button
                android:id="@+id/btnPaste"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_secondary_button"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:text="@string/btn_context_paste" />
            <Button
                android:id="@+id/btnExpandCtx"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_secondary_button"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:text="@string/btn_context_expand" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvContextFull"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:padding="8dp"
            android:background="@drawable/bg_context_chip"
            android:textColor="@color/text"
            android:textSize="14sp"
            android:visibility="gone"
            android:textIsSelectable="true" />

        <EditText
            android:id="@+id/editInternalDraft"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:padding="8dp"
            android:background="@drawable/bg_keycap"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:hint="@string/hint_ask" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/btnRewriteMode"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:background="@drawable/bg_secondary_button"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:text="@string/toolbar_rewrite" />
            <Button
                android:id="@+id/btnSend"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_primary_button"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:text="@string/btn_send" />
            <Button
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_secondary_button"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:visibility="gone"
                android:text="@string/btn_cancel" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAnswer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:padding="8dp"
            android:background="@drawable/bg_keycap"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:visibility="gone"
            android:textIsSelectable="true" />

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/answerActions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <Button
                android:id="@+id/btnFollowup"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:background="@drawable/bg_secondary_button"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:text="@string/btn_send_followup" />
            <Button
                android:id="@+id/btnCopy"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_secondary_button"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:text="@string/btn_copy" />
            <Button
                android:id="@+id/btnInsert"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_primary_button"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:text="@string/btn_insert" />
            <Button
                android:id="@+id/btnReplace"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_secondary_button"
                android:textColor="@color/text"
                android:textSize="13sp"
                android:visibility="gone"
                android:text="@string/btn_replace" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/answerActionsExtra"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:visibility="gone">
            <Button
                android:id="@+id/btnRetry"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:background="@drawable/bg_secondary_button"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:text="@string/btn_retry" />
            <Button
                android:id="@+id/btnUndo"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_secondary_button"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:visibility="gone"
                android:text="@string/btn_undo" />
        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/askKeypad"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
        <LinearLayout
            android:id="@+id/rowAsk1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
        <LinearLayout
            android:id="@+id/rowAsk2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
        <LinearLayout
            android:id="@+id/rowAsk3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
        <LinearLayout
            android:id="@+id/rowAskBottom"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
    </LinearLayout>
</LinearLayout>
